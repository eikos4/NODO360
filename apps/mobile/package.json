{
  "name": "@nodo360/mobile",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --port 5175",
    "prepare:ios-tones": "node scripts/prepare-ios-tones.mjs",
    "icons:launcher": "node scripts/generate-launcher-icons.mjs",
    "sync": "npm run build && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "check:firebase": "node scripts/check-firebase.mjs",
    "keystore": "node scripts/ensure-keystore.mjs",
    "apk:debug": "npm run sync && node scripts/assemble-apk.mjs debug",
    "apk:release": "npm run sync && node scripts/assemble-apk.mjs release"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-firebase/messaging": "^8.5.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@nodo360/shared": "1.0.0",
    "axios": "^1.6.7",
    "firebase": "^12.18.0",
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
