DATABASE_URL="postgresql://user:password@localhost:5432/nodo360"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
FRONTEND_URL="http://localhost:5173"

# Radio PTT usa WebSocket en namespace /radio (sin variables extra)

# Cloudinary — obligatorio en Render/producción (PDFs, fotos, logos)
# Crea cuenta gratis en https://cloudinary.com y copia las credenciales
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Alternativa: una sola URL
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# En producción: false para no recargar datos demo
# AUTO_SEED_DEMO=false

# Firebase Cloud Messaging — alarmas con la app cerrada
# Pega el JSON completo de la cuenta de servicio (una sola línea)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_WEB_API_KEY=""
FIREBASE_WEB_AUTH_DOMAIN=""
FIREBASE_WEB_PROJECT_ID=""
FIREBASE_WEB_STORAGE_BUCKET=""
FIREBASE_WEB_MESSAGING_SENDER_ID=""
FIREBASE_WEB_APP_ID=""
FIREBASE_WEB_VAPID_KEY=""
