DATABASE_URL="postgresql://user:password@localhost:5432/nodo360"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
FRONTEND_URL="http://localhost:5173"

# Radio PTT usa WebSocket en namespace /radio (sin variables extra)

# Cloudinary — obligatorio en Render/producción (PDFs, fotos, logos)
# Crea cuenta gratis en https://cloudinary.com y copia las credenciales
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Alternativa: una sola URL
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# En producción: false para no recargar datos demo
# AUTO_SEED_DEMO=false

# Firebase Cloud Messaging — alarmas con la app cerrada
# Pega el JSON completo de la cuenta de servicio (una sola línea)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_WEB_API_KEY=""
FIREBASE_WEB_AUTH_DOMAIN=""
FIREBASE_WEB_PROJECT_ID=""
FIREBASE_WEB_STORAGE_BUCKET=""
FIREBASE_WEB_MESSAGING_SENDER_ID=""
FIREBASE_WEB_APP_ID=""
FIREBASE_WEB_VAPID_KEY=""

# Solo habilitar después de aprobación Apple Critical Alerts, entitlement y
# provisioning profile válidos. En false se envía el mismo CAF sin flag critical.
IOS_CRITICAL_ALERTS_ENABLED=false

# Cola PostgreSQL de alarmas (opcionales; estos son los valores por defecto)
ALARM_WORKER_ENABLED=true
ALARM_WORKER_INTERVAL_MS=3000
ALARM_WORKER_BATCH_SIZE=25
ALARM_WORKER_MAX_ATTEMPTS=8
ALARM_WORKER_BACKOFF_BASE_MS=5000
ALARM_WORKER_LOCK_TIMEOUT_SECONDS=120
ALARM_QUEUE_TTL_SECONDS=86400
