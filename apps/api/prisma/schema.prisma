generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                    String                   @id @default(cuid())
  name                  String
  number                Int                      @unique
  region                String
  city                  String
  address               String
  phone                 String?
  email                 String?
  isActive              Boolean                  @default(true)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  headquartersImageUrl  String?
  logoUrl               String?
  dispatchSlug          String?                  @unique
  dispatchPublicEnabled Boolean                  @default(false)
  dispatchAvailable     Boolean                  @default(true)
  budgets               Budget[]
  drills                Drill[]
  emergencyBitacora     EmergencyBitacoraEntry[]
  emergencyPlans        EmergencyPlan[]
  equipment             Equipment[]
  evacuationRoutes      EvacuationRoute[]
  fleetLogs             FleetLog[]
  guardLogs             GuardLog[]
  healthRecords         HealthRecord[]
  hydrants              Hydrant[]
  incidents             Incident[]
  inventoryAudits       InventoryAudit[]
  invoices              Invoice[]
  meetingPoints         MeetingPoint[]
  certifications        MemberCertification[]
  memberProfiles        MemberProfile[]
  membershipFees        MembershipFee[]
  purchases             Purchase[]
  socialContributions   SocialContribution[]
  users                 User[]
  supportUsers          User[]                   @relation("UserSupportCompany")
  vehicles              Vehicle[]
}

model User {
  id                            String                      @id @default(cuid())
  rut                           String                      @unique
  firstName                     String
  lastName                      String
  email                         String                      @unique
  passwordHash                  String
  role                          Role                        @default(BOMBERO)
  isActive                      Boolean                     @default(true)
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  companyId                     String?
  stationAvailable              Boolean                     @default(false)
  stationAvailableAt            DateTime?
  photoUrl                      String?
  isMaquinista                  Boolean                     @default(false)
  maquinistaAvailable           Boolean                     @default(false)
  maquinistaPrincipal           Boolean                     @default(false)
  operativeNumber               Int?                        @unique
  supportCompanyId              String?
  emergencyBitacoraEntries      EmergencyBitacoraEntry[]
  fleetLogsDriven               FleetLog[]                  @relation("FleetLogDriver")
  fleetLogsRegistered           FleetLog[]                  @relation("FleetLogRegisteredBy")
  handoversFrom                 GuardHandover[]             @relation("HandoverFrom")
  handoversTo                   GuardHandover[]             @relation("HandoverTo")
  guardLogsOpened               GuardLog[]                  @relation("GuardLogOpenedBy")
  guardLogEntries               GuardLogEntry[]
  healthRecord                  HealthRecord?
  emergencyResponses            IncidentEmergencyResponse[]
  incidents                     IncidentParticipant[]
  inventoryAudits               InventoryAudit[]            @relation("InventoryAuditAuditor")
  certifications                MemberCertification[]
  memberProfile                 MemberProfile?
  shifts                        Shift[]
  contributions                 SocialContribution[]
  company                       Company?                    @relation(fields: [companyId], references: [id])
  supportCompany                Company?                    @relation("UserSupportCompany", fields: [supportCompanyId], references: [id])
  vehiclesAsPrincipalMaquinista Vehicle[]                   @relation("VehiclePrincipalMaquinista")
  achievements                  UserAchievement[]

  @@index([companyId])
}

model Vehicle {
  id                    String               @id @default(cuid())
  patent                String               @unique
  brand                 String
  model                 String
  year                  Int
  type                  String
  status                EquipmentStatus      @default(OPERATIVO)
  kilometers            Int                  @default(0)
  lastMaintenanceAt     DateTime?
  nextMaintenanceAt     DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  companyId             String
  imageUrl              String?
  principalMaquinistaId String?
  fleetLogs             FleetLog[]
  incidentVehicles      IncidentVehicle[]
  auditItems            InventoryAuditItem[]
  maintenances          Maintenance[]
  company               Company              @relation(fields: [companyId], references: [id])
  principalMaquinista   User?                @relation("VehiclePrincipalMaquinista", fields: [principalMaquinistaId], references: [id])

  @@index([companyId])
}

model Equipment {
  id           String               @id @default(cuid())
  name         String
  code         String               @unique
  category     String
  status       EquipmentStatus      @default(OPERATIVO)
  serial       String?
  purchaseDate DateTime?
  expiresAt    DateTime?
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  companyId    String
  imageUrl     String?
  quantity     Int                  @default(1)
  company      Company              @relation(fields: [companyId], references: [id])
  auditItems   InventoryAuditItem[]

  @@index([companyId])
}

model Incident {
  id                 String                      @id @default(cuid())
  code               String                      @unique
  type               String
  description        String
  address            String
  latitude           Float?
  longitude          Float?
  dispatchedAt       DateTime
  arrivedAt          DateTime?
  closedAt           DateTime?
  report             String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  companyId          String
  imageUrl           String?
  dispatchNotes      String?
  dispatchSource     DispatchSource?             @default(MANUAL)
  emergencyPlanId    String?
  planChecklist      Json?
  locationPinToken   String?                     @unique
  locationPinAt      DateTime?
  confirmedLatitude  Float?
  confirmedLongitude Float?
  locationPinNote    String?
  bitacoraEntry      EmergencyBitacoraEntry?
  guardLogEntries    GuardLogEntry?
  company            Company                     @relation(fields: [companyId], references: [id])
  emergencyPlan      EmergencyPlan?              @relation(fields: [emergencyPlanId], references: [id])
  emergencyResponses IncidentEmergencyResponse[]
  participants       IncidentParticipant[]
  vehicles           IncidentVehicle[]

  @@index([companyId])
}

model IncidentVehicle {
  id         String   @id @default(cuid())
  incidentId String
  vehicleId  String
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])

  @@unique([incidentId, vehicleId])
}

model IncidentParticipant {
  id         String   @id @default(cuid())
  incidentId String
  userId     String
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([incidentId, userId])
}

model Achievement {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  description      String
  icon             String            @default("Medal")
  color            String            @default("text-amber-400 bg-amber-500/10 border-amber-500/20")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model IncidentEmergencyResponse {
  id              String                  @id @default(cuid())
  incidentId      String
  userId          String
  status          EmergencyResponseStatus
  latitude        Float?
  longitude       Float?
  markerLatitude  Float?
  markerLongitude Float?
  note            String?
  respondedAt     DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  incident        Incident                @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incidentId, userId])
  @@index([incidentId])
  @@index([userId])
}

model Maintenance {
  id           String   @id @default(cuid())
  type         String
  description  String
  cost         Float?
  date         DateTime
  workshopName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
}

model Shift {
  id        String   @id @default(cuid())
  date      DateTime
  startTime String
  endTime   String
  present   Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model GuardLog {
  id           String          @id @default(cuid())
  companyId    String
  date         DateTime
  status       GuardLogStatus  @default(OPEN)
  openedById   String?
  closedById   String?
  closedAt     DateTime?
  closingNotes String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  handovers    GuardHandover[]
  company      Company         @relation(fields: [companyId], references: [id])
  openedBy     User?           @relation("GuardLogOpenedBy", fields: [openedById], references: [id])
  entries      GuardLogEntry[]

  @@unique([companyId, date])
}

model GuardLogEntry {
  id         String            @id @default(cuid())
  logId      String
  type       GuardLogEntryType @default(NOVEDAD)
  title      String
  content    String
  authorId   String
  createdAt  DateTime          @default(now())
  incidentId String?           @unique
  author     User              @relation(fields: [authorId], references: [id])
  incident   Incident?         @relation(fields: [incidentId], references: [id])
  log        GuardLog          @relation(fields: [logId], references: [id], onDelete: Cascade)
}

model GuardHandover {
  id           String   @id @default(cuid())
  logId        String
  fromUserId   String
  toUserId     String
  summary      String
  observations String?
  handedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  fromUser     User     @relation("HandoverFrom", fields: [fromUserId], references: [id])
  log          GuardLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  toUser       User     @relation("HandoverTo", fields: [toUserId], references: [id])
}

model Document {
  id         String    @id @default(cuid())
  title      String
  category   String
  fileUrl    String
  version    Int       @default(1)
  expiresAt  DateTime?
  uploadedBy String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  companyId  String?
  notes      String?
}

model Purchase {
  id          String         @id @default(cuid())
  number      String         @unique
  description String
  supplier    String
  status      PurchaseStatus @default(PENDIENTE)
  totalAmount Float
  requestedAt DateTime       @default(now())
  approvedAt  DateTime?
  receivedAt  DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  companyId   String
  invoices    Invoice[]
  company     Company        @relation(fields: [companyId], references: [id])
}

model Invoice {
  id         String    @id @default(cuid())
  number     String    @unique
  supplier   String
  amount     Float
  fileUrl    String?
  issuedAt   DateTime
  dueAt      DateTime?
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  purchaseId String?
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
}

model Budget {
  id          String         @id @default(cuid())
  year        Int
  category    BudgetCategory
  description String
  planned     Float
  executed    Float          @default(0)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])

  @@unique([companyId, year, category])
}

model Announcement {
  id             String                     @id @default(cuid())
  title          String
  content        String
  type           AnnouncementType           @default(ANNOUNCEMENT)
  priority       AnnouncementPriority       @default(MEDIUM)
  eventDate      DateTime?
  eventLocation  String?
  publishedBy    String
  publishedAt    DateTime                   @default(now())
  expiresAt      DateTime?
  isActive       Boolean                    @default(true)
  targetAudience AnnouncementTargetAudience @default(ALL)
  attachments    String[]
  companyId      String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
}

model Hydrant {
  id               String        @id @default(cuid())
  code             String        @unique
  type             HydrantType   @default(COLUMNAR)
  status           HydrantStatus @default(OPERATIVO)
  diameter         Int?
  pressure         Float?
  flowRate         Float?
  address          String
  location         String?
  latitude         Float?
  longitude        Float?
  lastInspectionAt DateTime?
  nextInspectionAt DateTime?
  notes            String?
  companyId        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  company          Company       @relation(fields: [companyId], references: [id])
}

model EmergencyPlan {
  id            String                    @id @default(cuid())
  title         String
  description   String
  emergencyType EmergencyType
  severity      EmergencySeverity
  procedures    Json
  companyId     String
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  checklist     Json                      @default("[]")
  status        EmergencyPlanStatus       @default(DRAFT)
  version       Int                       @default(1)
  drills        Drill[]
  company       Company                   @relation(fields: [companyId], references: [id])
  attachments   EmergencyPlanAttachment[]
  versions      EmergencyPlanVersion[]
  incidents     Incident[]
}

model EmergencyPlanAttachment {
  id         String        @id @default(cuid())
  planId     String
  name       String
  fileUrl    String
  mimeType   String?
  sizeBytes  Int?
  uploadedAt DateTime      @default(now())
  plan       EmergencyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model EmergencyPlanVersion {
  id            String              @id @default(cuid())
  planId        String
  version       Int
  title         String
  description   String
  emergencyType EmergencyType
  severity      EmergencySeverity
  status        EmergencyPlanStatus
  procedures    Json
  checklist     Json
  changedBy     String?
  snapshotAt    DateTime            @default(now())
  plan          EmergencyPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, version])
}

model Drill {
  id              String         @id @default(cuid())
  title           String
  description     String
  scheduledAt     DateTime
  executedAt      DateTime?
  status          DrillStatus    @default(PROGRAMADO)
  participants    String[]
  notes           String?
  emergencyPlanId String?
  companyId       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  company         Company        @relation(fields: [companyId], references: [id])
  emergencyPlan   EmergencyPlan? @relation(fields: [emergencyPlanId], references: [id])
}

model EvacuationRoute {
  id          String   @id @default(cuid())
  name        String
  description String?
  startPoint  Json
  endPoint    Json
  waypoints   Json?
  buildingId  String?
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id])
}

model MeetingPoint {
  id          String   @id @default(cuid())
  name        String
  description String?
  location    Json
  address     String?
  capacity    Int?
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id])
}

model MemberProfile {
  id           String           @id @default(cuid())
  memberNumber String?
  status       MembershipStatus @default(ACTIVO)
  joinedAt     DateTime?
  notes        String?
  userId       String           @unique
  companyId    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  company      Company          @relation(fields: [companyId], references: [id])
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MembershipFee {
  id            String               @id @default(cuid())
  name          String
  description   String?
  amount        Float
  frequency     FeeFrequency         @default(MENSUAL)
  year          Int
  month         Int?
  dueDate       DateTime?
  isActive      Boolean              @default(true)
  companyId     String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  company       Company              @relation(fields: [companyId], references: [id])
  contributions SocialContribution[]
}

model SocialContribution {
  id            String             @id @default(cuid())
  amount        Float
  paidAt        DateTime
  method        PaymentMethod      @default(EFECTIVO)
  status        ContributionStatus @default(PAGADO)
  receiptNumber String?
  notes         String?
  userId        String
  companyId     String
  feeId         String?
  recordedBy    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  company       Company            @relation(fields: [companyId], references: [id])
  fee           MembershipFee?     @relation(fields: [feeId], references: [id])
  user          User               @relation(fields: [userId], references: [id])

  @@index([companyId, feeId])
  @@index([userId, feeId])
}

model MemberCertification {
  id          String                @id @default(cuid())
  name        String
  category    CertificationCategory @default(OTRO)
  issuer      String?
  issuedAt    DateTime?
  expiresAt   DateTime?
  documentUrl String?
  notes       String?
  userId      String
  companyId   String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  company     Company               @relation(fields: [companyId], references: [id])
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([expiresAt])
}

model InventoryAudit {
  id           String               @id @default(cuid())
  code         String               @unique
  title        String?
  status       InventoryAuditStatus @default(BORRADOR)
  companyId    String
  auditorId    String?
  startedAt    DateTime?
  completedAt  DateTime?
  closingNotes String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  auditor      User?                @relation("InventoryAuditAuditor", fields: [auditorId], references: [id])
  company      Company              @relation(fields: [companyId], references: [id])
  items        InventoryAuditItem[]

  @@index([companyId])
  @@index([status])
}

model InventoryAuditItem {
  id             String                   @id @default(cuid())
  auditId        String
  kind           InventoryAuditItemKind
  vehicleId      String?
  equipmentId    String?
  expectedLabel  String
  expectedStatus EquipmentStatus?
  expectedQty    Int                      @default(1)
  found          Boolean?
  physicalStatus EquipmentStatus?
  physicalQty    Int?
  result         InventoryAuditItemResult @default(PENDIENTE)
  observations   String?
  verifiedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  audit          InventoryAudit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  equipment      Equipment?               @relation(fields: [equipmentId], references: [id])
  vehicle        Vehicle?                 @relation(fields: [vehicleId], references: [id])

  @@index([auditId])
  @@index([result])
}

model EmergencyBitacoraEntry {
  id             String                  @id @default(cuid())
  companyId      String
  incidentId     String?                 @unique
  title          String
  emergencyType  String?
  address        String?
  occurredAt     DateTime
  summary        String
  actionsTaken   String?
  personnelNotes String?
  vehicleNotes   String?
  outcome        String?
  observations   String?
  source         EmergencyBitacoraSource @default(MANUAL)
  authorId       String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  author         User?                   @relation(fields: [authorId], references: [id])
  company        Company                 @relation(fields: [companyId], references: [id])
  incident       Incident?               @relation(fields: [incidentId], references: [id])

  @@index([companyId])
  @@index([occurredAt])
}

model FleetLog {
  id             String       @id @default(cuid())
  type           FleetLogType @default(COMBUSTIBLE)
  date           DateTime
  vehicleId      String
  companyId      String
  driverId       String?
  registeredById String
  odometerKm     Int
  fuelLiters     Float?
  fuelCost       Float?
  fuelStation    String?
  fullTank       Boolean      @default(false)
  serviceLabel   String?
  description    String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  company        Company      @relation(fields: [companyId], references: [id])
  driver         User?        @relation("FleetLogDriver", fields: [driverId], references: [id])
  registeredBy   User         @relation("FleetLogRegisteredBy", fields: [registeredById], references: [id])
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])

  @@index([companyId])
  @@index([vehicleId])
  @@index([date])
  @@index([type])
}

model HealthRecord {
  id               String             @id @default(cuid())
  bloodType        BloodType          @default(UNKNOWN)
  emergencyContact String?
  emergencyPhone   String?
  chronicDiseases  String?
  surgeries        String?
  notes            String?
  lastCheckupAt    DateTime?
  nextCheckupAt    DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  userId           String             @unique
  companyId        String
  allergies        Allergy[]
  company          Company            @relation(fields: [companyId], references: [id])
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  conditions       MedicalCondition[]
  medicalExams     MedicalExam[]
  medications      Medication[]
  vaccinations     Vaccination[]

  @@index([userId])
  @@index([companyId])
}

model MedicalExam {
  id             String            @id @default(cuid())
  type           MedicalExamType
  name           String
  description    String?
  examDate       DateTime
  result         String?
  status         MedicalExamStatus @default(PROGRAMADO)
  fileUrl        String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  healthRecordId String
  healthRecord   HealthRecord      @relation(fields: [healthRecordId], references: [id], onDelete: Cascade)

  @@index([healthRecordId])
  @@index([examDate])
  @@index([status])
}

model MedicalCondition {
  id             String                  @id @default(cuid())
  name           String
  description    String?
  diagnosedAt    DateTime?
  severity       HealthConditionSeverity @default(MODERADO)
  isActive       Boolean                 @default(true)
  notes          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  healthRecordId String
  healthRecord   HealthRecord            @relation(fields: [healthRecordId], references: [id], onDelete: Cascade)

  @@index([healthRecordId])
  @@index([isActive])
}

model Allergy {
  id             String       @id @default(cuid())
  name           String
  type           String?
  severity       String?
  reaction       String?
  isActive       Boolean      @default(true)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  healthRecordId String
  healthRecord   HealthRecord @relation(fields: [healthRecordId], references: [id], onDelete: Cascade)

  @@index([healthRecordId])
  @@index([isActive])
}

model Medication {
  id             String       @id @default(cuid())
  name           String
  dosage         String?
  frequency      String?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean      @default(true)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  healthRecordId String
  healthRecord   HealthRecord @relation(fields: [healthRecordId], references: [id], onDelete: Cascade)

  @@index([healthRecordId])
  @@index([isActive])
}

model Vaccination {
  id             String       @id @default(cuid())
  name           String
  vaccineType    String?
  dose           String?
  administeredAt DateTime?
  nextDoseAt     DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  healthRecordId String
  healthRecord   HealthRecord @relation(fields: [healthRecordId], references: [id], onDelete: Cascade)

  @@index([healthRecordId])
  @@index([administeredAt])
}

enum Role {
  SUPER_ADMIN
  COMANDANTE
  CAPITAN
  ENCARGADO_MATERIAL
  SECRETARIO
  TESORERO
  BOMBERO
  AUDITOR
  OPERADOR_CENTRAL
}

enum EquipmentStatus {
  OPERATIVO
  EN_REPARACION
  FUERA_DE_SERVICIO
}

enum DispatchSource {
  BOTONERA
  MANUAL
}

enum EmergencyResponseStatus {
  GOING
  NOT_GOING
  NOT_AVAILABLE
  ON_SCENE
  LOCATION_MARKED
}

enum GuardLogStatus {
  OPEN
  CLOSED
}

enum GuardLogEntryType {
  NOVEDAD
  REVISION
  VISITA
  COMUNICACION
  MANTENIMIENTO
  OTRO
}

enum PurchaseStatus {
  PENDIENTE
  APROBADA
  RECIBIDA
  RECHAZADA
}

